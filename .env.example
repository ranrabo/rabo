# Neon Postgres — pooled connection string used by the app at runtime
DATABASE_URL=

# Neon Postgres — direct (unpooled) connection string used by drizzle-kit
# (generate / push / migrate). Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# NextAuth session secret. NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET=

# Only needed to run `npm run db:seed` (src/db/seed.ts). Passwords must be >= 12 chars.
SEED_USER_ONE_EMAIL=
SEED_USER_ONE_PASSWORD=
SEED_USER_TWO_EMAIL=
SEED_USER_TWO_PASSWORD=
